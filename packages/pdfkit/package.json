{
  "name": "@react-pdf/pdfkit",
  "version": "6.0.1",
  "license": "MIT",
  "description": "A PDF generation library for Node.js",
  "type": "module",
  "main": "./lib/pdfkit.js",
  "browser": {
    "./lib/pdfkit.js": "./lib/pdfkit.browser.js"
  },
  "exports": {
    ".": {
      "browser": "./lib/pdfkit.browser.js",
      "default": "./lib/pdfkit.js"
    },
    "./standard-fonts/Courier": "./lib/standard-fonts/Courier.js",
    "./standard-fonts/CourierBold": "./lib/standard-fonts/CourierBold.js",
    "./standard-fonts/CourierBoldOblique": "./lib/standard-fonts/CourierBoldOblique.js",
    "./standard-fonts/CourierOblique": "./lib/standard-fonts/CourierOblique.js",
    "./standard-fonts/Helvetica": "./lib/standard-fonts/Helvetica.js",
    "./standard-fonts/HelveticaBold": "./lib/standard-fonts/HelveticaBold.js",
    "./standard-fonts/HelveticaBoldOblique": "./lib/standard-fonts/HelveticaBoldOblique.js",
    "./standard-fonts/HelveticaOblique": "./lib/standard-fonts/HelveticaOblique.js",
    "./standard-fonts/Symbol": "./lib/standard-fonts/Symbol.js",
    "./standard-fonts/TimesBold": "./lib/standard-fonts/TimesBold.js",
    "./standard-fonts/TimesBoldItalic": "./lib/standard-fonts/TimesBoldItalic.js",
    "./standard-fonts/TimesItalic": "./lib/standard-fonts/TimesItalic.js",
    "./standard-fonts/TimesRoman": "./lib/standard-fonts/TimesRoman.js",
    "./standard-fonts/ZapfDingbats": "./lib/standard-fonts/ZapfDingbats.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/diegomura/react-pdf.git",
    "directory": "packages/pdfkit"
  },
  "author": {
    "name": "Devon Govett",
    "email": "devongovett@gmail.com",
    "url": "http://badassjs.com/"
  },
  "scripts": {
    "test": "vitest",
    "clear": "rimraf ./lib",
    "build": "npm run clear && rollup -c",
    "watch": "npm run clear && rollup -c -w"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@babel/runtime": "^7.20.13",
    "@noble/ciphers": "^1.0.0",
    "@noble/hashes": "^1.6.0",
    "fflate": "^0.8.2",
    "fontkit": "^2.0.2",
    "js-md5": "^0.8.3",
    "linebreak": "^1.1.0",
    "png-js": "^2.0.0",
    "vite-compatible-readable-stream": "^3.6.1"
  }
}
